{%- if theme.open_graph.enable %}
  {%- if theme.open_graph.options %}
    {{ open_graph(theme.open_graph.options) }}
  {%- else %}
    {{ open_graph() }}
  {%- endif %}
{%- endif %}

{# https://github.com/theme-next/hexo-theme-next/issues/866 #}
{%- set canonical = url | replace(r/index\.html$/, '') %}
{%- if not config.permalink.endsWith('.html') %}
  {%- set canonical = canonical | replace(r/\.html$/, '') %}
{%- endif %}
<link rel="canonical" href="{{ canonical }}">

{%- set page_url = canonical %}
{%- set page_name = page.title or config.title %}
{%- set page_description = page.description or (page.excerpt and truncate(strip_html(page.excerpt), {length: 200, separator: ' '})) or config.description %}
{%- set is_article = page.layout === 'post' or page.type === 'post' %}
{%- set is_homepage = is_home() %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": {% if is_article %}"BlogPosting"{% elif is_homepage %}"WebSite"{% else %}"WebPage"{% endif %},
  "@id": {{ page_url | dump | safe }},
  "url": {{ page_url | dump | safe }},
  "name": {{ page_name | dump | safe }},
  "description": {{ page_description | dump | safe }},
  "inLanguage": {{ (page.lang or config.language or 'zh-TW') | dump | safe }}{% if is_article %},
  "headline": {{ page.title | dump | safe }},
  "datePublished": {{ moment(page.date).format() | dump | safe }},
  "dateModified": {{ moment(page.updated or page.date).format() | dump | safe }},
  "author": {
    "@type": "Person",
    "name": {{ config.author | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ config.title | dump | safe }}
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ page_url | dump | safe }}
  }{% if page.cover %},
  "image": {{ full_url_for(page.cover) | dump | safe }}{% endif %}{% if page.categories and page.categories.length %},
  "articleSection": [
    {%- for category in page.categories.toArray() %}
    {{ category.name | dump | safe }}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]{% endif %}{% if page.tags and page.tags.length %},
  "keywords": [
    {%- for tag in page.tags.toArray() %}
    {{ tag.name | dump | safe }}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]{% endif %}{% endif %}
}
</script>

{%- if page.noindex %}
<meta name="robots" content="noindex">
{%- endif %}
{# Exports some front-matter variables to Front-End #}
{# https://hexo.io/docs/variables.html #}
{{ next_data('page', next_config_unique()) }}

{{ next_data('calendar',
  theme.calendar if page.type === 'schedule' else '')
}}
