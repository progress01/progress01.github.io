/* Profile route cards: retain the site's paper palette with a clear, responsive hierarchy. */
.profile-page .profile-home-header {
  margin-bottom: 30px;
  text-align: left;
}

.profile-page .profile-home-header .post-title {
  color: var(--surface-ink);
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.25;
}

.profile-page .profile-path {
  margin: 0 0 34px;
}

.profile-page .profile-path h2,
.profile-page .profile-learning h2 {
  margin: 0 0 14px;
  padding-bottom: 9px;
  color: var(--surface-ink);
  border-bottom: 2px solid var(--surface-border);
  font-size: 21px;
  line-height: 1.45;
}

.profile-page .profile-path h2 {
  margin-bottom: 20px;
  font-family: system-ui, "Segoe UI", "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 1.55;
}

.main-menu[data-navigation-surface="profile"] .menu-item-profile-home > a,
.main-menu[data-navigation-surface="profile"] .menu-item-profile-paths > a,
.main-menu[data-navigation-surface="profile"] .menu-item-profile-articles > a {
  display: flex;
  box-sizing: border-box;
  min-height: 48px;
  align-items: center;
  padding: 9px 20px;
  font-family: system-ui, "Segoe UI", "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 0;
}

.main-menu[data-navigation-surface="profile"] .menu-item-profile-home > a i,
.main-menu[data-navigation-surface="profile"] .menu-item-profile-paths > a i,
.main-menu[data-navigation-surface="profile"] .menu-item-profile-articles > a i {
  flex: 0 0 auto;
  margin-right: 12px;
}

.profile-page .profile-path-items {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.profile-page .profile-learning {
  margin: 0 0 26px;
}

.profile-page .profile-learning-empty {
  margin: 0;
  padding: 14px 16px;
  color: var(--surface-muted);
  background: var(--surface-panel);
  border-left: 3px solid var(--surface-accent);
}

.profile-page .profile-articles-empty {
  margin: 0;
  padding: 14px 16px;
  color: var(--surface-muted);
  background: var(--surface-panel);
  border-left: 3px solid var(--surface-accent);
}

.profile-page .profile-all-articles {
  margin: 18px 0 0;
  text-align: right;
}

.profile-page .profile-library-count {
  margin: 0 0 12px;
  color: var(--surface-muted);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
}

.profile-page .profile-tag-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 18px;
}

.profile-page .profile-tag-filters[hidden],
.profile-page .profile-library-empty[hidden],
.profile-page .profile-article-row[hidden] {
  display: none;
}

.profile-page .profile-tag-filter {
  min-height: 40px;
  padding: 6px 12px;
  color: var(--surface-ink);
  background: var(--surface-panel);
  border: 1px solid var(--surface-border);
  border-radius: 2px;
  font: 500 14px/1.45 system-ui, "Segoe UI", "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
  cursor: pointer;
}

.profile-page .profile-tag-filter span {
  margin-left: 4px;
  color: var(--surface-muted);
  font-size: 12px;
}

.profile-page .profile-tag-filter.is-active,
.profile-page .profile-tag-filter:hover,
.profile-page .profile-tag-filter:focus-visible {
  color: var(--surface-accent-strong);
  border-color: var(--surface-accent-strong);
}

.profile-page .profile-tag-filter:focus-visible {
  outline: 3px solid var(--surface-focus);
  outline-offset: 2px;
}

.profile-page .profile-article-list {
  position: relative;
  margin: 0 0 0 8px;
  padding: 0 0 0 18px;
  list-style: none;
}

.profile-page .profile-article-list::before {
  position: absolute;
  top: 6px;
  bottom: 8px;
  left: 1px;
  width: 2px;
  background: var(--surface-border);
  content: '';
}

.profile-page .profile-article-row {
  position: relative;
  margin: 0;
}

.profile-page .profile-list-entry {
  margin: 0;
  padding: 9px 0 10px;
  border-bottom: 1px dashed var(--surface-border);
}

.profile-page .profile-list-entry::before {
  position: absolute;
  top: 15px;
  left: -21px;
  width: 7px;
  height: 7px;
  background: var(--surface-accent);
  border: 1px solid var(--surface-paper);
  border-radius: 50%;
  content: '';
}

.profile-page .profile-list-link {
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr);
  gap: 12px;
  align-items: baseline;
  color: var(--surface-ink);
  text-decoration: none;
}

.profile-page .profile-list-date {
  color: var(--surface-muted);
  font: 12px/1.5 "Courier New", monospace;
}

.profile-page .profile-list-title {
  font-size: 16px;
  font-weight: 500;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.profile-page .profile-list-link:hover .profile-list-title,
.profile-page .profile-list-link:focus-visible .profile-list-title {
  color: var(--surface-accent-strong);
}

.profile-page .profile-list-link:focus-visible {
  outline: 3px solid var(--surface-focus);
  outline-offset: 3px;
}

.profile-page .profile-library-empty {
  margin: 0 0 12px;
  color: var(--surface-muted);
}

.profile-page .profile-all-articles a,
.profile-articles-page .profile-navigation a {
  color: var(--surface-accent-strong);
  font-weight: 600;
}

.profile-page .profile-navigation {
  margin-top: 12px;
  padding-top: 17px;
  border-top: 1px solid var(--surface-border);
  text-align: right;
}

.profile-page .profile-article-calendar {
  max-width: 900px;
  margin: 0 auto;
}

.profile-page .profile-calendar-year {
  margin: 0 0 6px;
  color: var(--surface-ink);
  font-size: clamp(22px, 2.5vw, 28px);
  font-weight: 600;
  letter-spacing: .02em;
}

.profile-page .profile-calendar-status {
  margin: 0;
  color: var(--surface-muted);
  font-size: 13px;
}

.profile-page .profile-calendar-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin: 12px 2px 5px;
  color: var(--surface-muted);
  font-size: 12px;
}

.profile-page .profile-calendar-gradient {
  width: 104px;
  height: 9px;
  background: linear-gradient(90deg, var(--surface-panel), var(--surface-border), var(--surface-accent), var(--surface-accent-strong));
  border: 1px solid var(--surface-border);
}

.profile-page .profile-calendar-scroll {
  position: relative;
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}

.profile-page .profile-calendar-chart {
  width: 100%;
  min-width: 0;
  height: 250px;
}

.profile-page .profile-calendar-fallback {
  margin: 0;
  padding: 18px 4px;
  color: var(--surface-muted);
}

.profile-page .profile-calendar-fallback a {
  color: var(--surface-accent-strong);
  text-decoration: underline;
}

.profile-page .profile-calendar-controls {
  position: absolute;
  z-index: 2;
  top: 80px;
  right: 30px;
  left: 30px;
  display: grid;
  grid-template-columns: repeat(53, minmax(0, 1fr));
  grid-template-rows: repeat(7, 13px);
  height: 91px;
}

.profile-page .profile-calendar-day-control {
  min-width: 0;
  margin: 0;
  padding: 0;
  color: transparent;
  background: transparent;
  border: 0;
  cursor: pointer;
}

.profile-page .profile-calendar-day-control:hover,
.profile-page .profile-calendar-day-control[aria-pressed="true"] {
  background: var(--surface-panel);
  outline: 1px solid var(--surface-accent);
}

.profile-page .profile-calendar-day-control:focus-visible {
  outline: 3px solid var(--surface-focus);
  outline-offset: -1px;
}

.profile-page .profile-calendar-details {
  margin-top: 18px;
  padding-top: 12px;
  border-top: 1px solid var(--surface-border);
}

.profile-page .profile-calendar-details h3 {
  margin: 0 0 8px;
  color: var(--surface-accent-strong);
  font-size: 16px;
  font-weight: 600;
}

.profile-page .profile-calendar-updates {
  display: grid;
  gap: 2px;
}

.profile-page .profile-calendar-article {
  display: block;
  min-width: 44px;
  min-height: 44px;
  padding: 10px 4px;
  color: var(--surface-ink);
  border-bottom: 1px solid var(--surface-border);
  overflow-wrap: anywhere;
}

.profile-page .profile-calendar-event-label {
  display: inline-block;
  margin-right: 8px;
  padding: 1px 6px;
  color: var(--surface-accent-strong);
  border: 1px solid var(--surface-border);
  border-radius: 2px;
  font-size: 11px;
  line-height: 1.6;
  vertical-align: 1px;
}

.profile-page .profile-calendar-event-label[data-event-type="updated"] {
  color: var(--surface-ink);
}

.profile-page .profile-calendar-article:hover,
.profile-page .profile-calendar-article:focus-visible {
  color: var(--surface-accent-strong);
}

.profile-page .profile-calendar-article:focus-visible {
  outline: 3px solid var(--surface-focus);
  outline-offset: 2px;
}

.profile-page .profile-navigation a {
  color: var(--surface-accent-strong);
  font-family: "Courier New", monospace;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: .04em;
}

.profile-page .profile-navigation a:focus-visible {
  outline: 3px solid var(--surface-focus);
  outline-offset: 4px;
}

@media (max-width: 600px) {
  .profile-page .profile-path-items {
    grid-template-columns: 1fr;
  }

  .profile-page .profile-calendar-scroll {
    overscroll-behavior-x: contain;
  }

  .profile-page .profile-calendar-chart {
    width: 700px;
    min-width: 700px;
  }

  .profile-page .profile-calendar-controls {
    top: 30px;
    right: auto;
    left: 5px;
    width: 690px;
    grid-template-rows: repeat(7, 10px);
    height: 70px;
  }

  .profile-page .profile-list-link {
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 8px;
  }

  .profile-page .profile-list-title {
    font-size: 15px;
  }
}
