/* Shared paper language with route-scoped memory and profile accents. */
:root {
  --surface-paper: #f4f0e6;
  --surface-base: #f4f0e6;
  --surface-panel: #f5ead9;
  --surface-ink: #4a3028;
  --surface-muted: #6b5547;
  --surface-border: #d8c8b4;
  --surface-accent: #914a32;
  --surface-accent-strong: #79382f;
  --surface-focus: #243d4b;
  --surface-shadow: 3px 3px 0 rgba(74, 48, 40, .1);
}

/* B / memory keeps its warm archive and tape palette. */
.main-inner.index {
  --surface-paper: #f4f0e6;
  --surface-base: #f4f0e6;
  --surface-panel: #f1e4d1;
  --surface-ink: #4a3028;
  --surface-muted: #6b5547;
  --surface-border: #d8c8b4;
  --surface-accent: #914a32;
  --surface-accent-strong: #79382f;
  --surface-focus: #332a25;
  --surface-shadow: 3px 3px 0 rgba(74, 48, 40, .14);
}

/* A / profile uses a precise blue-green workbench over the shared paper. */
.main-inner.profile-page {
  --surface-paper: #f4f0e6;
  --surface-base: #f4f0e6;
  --surface-panel: #e8eef0;
  --surface-ink: #263c47;
  --surface-muted: #4e626a;
  --surface-border: #b8c8cc;
  --surface-accent: #326f68;
  --surface-accent-strong: #24564f;
  --surface-focus: #244f5a;
  --surface-shadow: 2px 3px 0 rgba(36, 63, 75, .1);
}
