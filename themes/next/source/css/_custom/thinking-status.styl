.post-thinking-status {
  box-sizing: border-box;
  max-width: 680px;
  margin: 0 0 28px;
  padding: 13px 16px;
  border: 1px solid #d8c8b4;
  border-left: 3px solid #a98261;
  background: #f8f4ec;
  color: #5d5146;
  overflow-wrap: anywhere;
}

.post-thinking-status h2 {
  margin: 0 0 8px;
  color: #5d5146;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.55;
}

.post-thinking-status p {
  margin: 3px 0 0;
  font-size: 13px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.post-thinking-status p span {
  color: #756758;
  font-weight: 600;
}

.profile-page .profile-thinking-label {
  color: var(--surface-muted);
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

@media (max-width: 600px) {
  .post-thinking-status {
    max-width: 100%;
    padding: 12px 13px;
  }
}
