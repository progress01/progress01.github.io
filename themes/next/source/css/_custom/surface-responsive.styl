/* Responsive safety for the dual-surface journey and long user-authored text. */
.main-inner,
.main-inner .post-block,
.main-inner .post-body,
.main-inner .post-content-single,
.main-inner .post-content-single .post-body,
.profile-page .profile-path-items,
.profile-page .profile-path-items > li,
.profile-page .profile-calendar-months,
.profile-page .profile-calendar-month,
.profile-page .profile-calendar-entry,
.surface-switch,
.surface-switch-link,
.post-surface-marker,
.post-thinking-status,
.post-thinking-status h2,
.post-thinking-status p,
.index .home-random-card,
.index .home-random-copy,
.index .home-random-card h2,
.index .home-archive-rail-main,
.index .home-pick-grid,
.index .home-pick,
.index .home-landing-entry-grid,
.index .home-landing-entry,
.index .home-profile-bridge,
.index .home-profile-bridge h2,
.index .home-profile-bridge p {
  box-sizing: border-box;
  min-width: 0;
  overflow-wrap: anywhere;
}

.profile-page .profile-path-items {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 767px) {
  .profile-page .profile-path-items {
    grid-template-columns: minmax(0, 1fr);
  }

  .profile-page .profile-calendar-months {
    grid-template-columns: minmax(0, 1fr);
  }

  .surface-switch {
    position: static;
    max-width: 100%;
  }

  .surface-switch-link {
    max-width: 100%;
  }

  .index .home-pick-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .index .home-landing-entry-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 430px) {
  .index .home-landing-entry-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
