{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "check:content": "node tools/content-check.js",
    "check:article-scaffold": "node tools/article-scaffold-check.js",
    "check:profile-home": "node tools/profile-home-check.js",
    "check:surface-copy": "node tools/surface-copy-check.js",
    "check:surface-copy-output": "node tools/surface-copy-check.js --root public",
    "check:profile-page": "node tools/profile-page-output-check.js",
    "check:profile-articles": "node tools/profile-articles-output-check.js",
    "check:surface-control": "node tools/surface-control-output-check.js",
    "check:home-profile-bridge": "node tools/home-profile-bridge-output-check.js",
    "check:contextual-menu": "node tools/contextual-menu-output-check.js",
    "check:sidebar-stats": "node tools/sidebar-stats-output-check.js --root public",
    "check:post-surface": "node tools/post-surface-output-check.js",
    "check:thinking-status-output": "node tools/thinking-status-output-check.js",
    "check:surface-visual": "node tools/surface-visual-check.js",
    "check:surface-transition": "node tools/surface-transition-check.js",
    "check:surface-accessibility": "node tools/surface-accessibility-check.js",
    "check:surface-responsive": "node tools/surface-responsive-check.js",
    "check:surface-history": "node tools/surface-history-output-check.js",
    "check:search-surface": "node tools/search-surface-output-check.js",
    "check:search-state": "node tools/search-surface-output-check.js",
    "check:random-surface": "node tools/random-surface-output-check.js",
    "check:archive-category-compat": "node tools/archive-category-compat-output-check.js",
    "check:public-boundary": "node tools/public-boundary-check.js",
    "check:public-output": "node tools/public-output-audit.js --root public",
    "check:tags": "node tools/tag-reorganization-check.js",
    "check:song-tags": "node tools/song-language-tags.js",
    "check:excerpt": "node tools/excerpt-check.js",
    "check:site": "node tools/site-check.js",
    "check:seo-urls": "node tools/seo-url-audit.js --root public",
    "check:surface-regression": "node tools/surface-target-regression-check.js",
    "test:regression": "node --test --test-concurrency=1 tools/tests/*.test.js",
    "test:blogger": "python -B -m unittest discover -s tools/tests -p \"test_blogger*.py\"",
    "verify": "npm run check:content && npm run check:article-scaffold && npm run check:profile-home && npm run check:surface-copy && npm run check:surface-visual && npm run check:surface-transition && npm run check:surface-accessibility && npm run check:surface-responsive && npm run check:tags && npm run check:song-tags && npm run test:regression && npm run clean && npm run build && npm run check:surface-copy-output && npm run check:site && npm run check:archive-category-compat && npm run check:sidebar-stats && npm run check:seo-urls && npm run check:public-output",
    "clean": "hexo clean",
    "deploy": "npm run verify && hexo deploy",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "echarts": "^6.0.0",
    "hexo": "^8.0.0",
    "hexo-calendar": "^1.1.1",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-related-popular-posts": "^5.0.1",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-symbols-count-time": "^0.7.1",
    "hexo-theme-landscape": "^1.0.0",
    "js-yaml": "^4.1.1",
    "moment-timezone": "^0.5.48",
    "object-assign": "^4.1.1"
  }
}
